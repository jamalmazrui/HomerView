; accept.inix -- what "done" means for HomerView.
;
; check runs these and records each command with its exit code in the
; evidence report. release refuses to publish while any of them fails.

FileTask = accept

[check]
Name = the build script runs clean, against the kit
Run = build.cmd nobump
Expect = 0

[check]
Name = the bridge was produced
Run = cmd /c if exist exec\HomerView.exe (exit 0) else (exit 1)
Expect = 0

[check]
Name = the NVDA add-on was produced
Run = cmd /c if exist exec\HomerView.nvda-addon (exit 0) else (exit 1)
Expect = 0

[check]
Name = the installer was produced, at the top of the project where release looks
Run = cmd /c if exist HomerView_setup.exe (exit 0) else (exit 1)
Expect = 0

[check]
Name = the twenty agreement checks pass
Run = scripts\checkHomerViewQuality.cmd
Expect = 0

; checkParity is a REPORT, not a gate. It measures how far the two readers
; match rather than asserting they do, and it has fourteen known gaps that
; are argued about rather than fixed. It always exits 0, so it is not listed
; here as a check; its log is worth reading before a release all the same.
